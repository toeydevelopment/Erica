{
  "default": {
    "long_lived_patterns": ["epic/*", "release/*", "develop"],
    "max_branch_age_hours": 48,
    "max_changed_lines": 400,
    "max_changed_files": 20,
    "exclude_globs": ["factory/tests/fixtures/**", "**/*.lock", "**/package-lock.json"],
    "require_issue_link": false,
    "forbid_merge_commits": true,
    "require_workflows": []
  },
  "repos": {
    "example-org/example-api": {
      "max_changed_lines": 600,
      "require_workflows": ["e2e.yml"]
    }
  }
}
