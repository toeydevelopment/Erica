# runners.env - example values for the self-hosted runner skill and sampler.
# Copy to config/runners.env in your firstmate home and edit.
# Read by skills/sf-runner-ops and factory/bin/sf-runner-sample.sh.
# Plain KEY=value lines only. Keep real host names out of tracked files.

# How to reach the runner machine (an ssh alias or user@host) and its names.
SF_RUNNER_SSH=runner-vm
SF_RUNNER_VM=runner-vm
SF_RUNNER_ORG=example-org
SF_RUNNER_LABELS=self-hosted,Linux,X64
SF_RUNNER_BASELINE_UNIT=actions.runner.example-org.runner-1.service
SF_RUNNER_AUTOSCALE_UNIT=runner-autoscale.service
SF_RUNNER_AUTOSCALE_CONFIG=/etc/runner-autoscale/config.json
SF_RUNNER_MAINTENANCE_FLAG=/run/runner-maintenance

# Hard ceiling the skill will never advise going above, without a fresh explicit yes.
SF_RUNNER_MAX_CAP=6

# Paths on the runner machine that the sampler measures.
SF_RUNNER_DISK_PATH=/
SF_RUNNER_TMPFS_PATH=/tmp

# Sampler thresholds. The sampler wakes firstmate only when one is crossed.
SF_RUNNER_DISK_PCT_MAX=85
SF_RUNNER_TMPFS_PCT_MAX=80
SF_RUNNER_MEM_AVAIL_MB_MIN=4096
SF_RUNNER_BUSY_MAX=5

# Minimum seconds between two wake messages from the sampler.
SF_RUNNER_BACKOFF_SECONDS=1200

# Seconds before the sampler gives up on ssh.
SF_RUNNER_SSH_TIMEOUT=20
